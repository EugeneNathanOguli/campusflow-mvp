# Copy this file to secrets.toml for local development.
# Never commit secrets.toml or share this value.
admin_passcode = "replace-with-a-long-random-passcode"

# Optional production authentication. When client_id is configured,
# CampusFlow requires Streamlit OIDC sign-in before showing the app.
# [auth]
# redirect_uri = "https://your-app.example.com/oauth2callback"
# cookie_secret = "replace-with-a-long-random-cookie-secret"
# client_id = "your-oidc-client-id"
# client_secret = "your-oidc-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Optional hosted persistence. Use the Supabase project URL and service-role key.
# Keep the service-role key private and never expose it to the browser.
# [supabase]
# url = "https://your-project.supabase.co"
# service_role_key = "your-supabase-service-role-key"

# Optional MTN MoMo sandbox integration. Create sandbox API users and
# subscriptions for both Collection and Disbursement in the MTN portal.
# These credentials are server-side only; never commit secrets.toml.
# [mtn_momo]
# collection_subscription_key = "your-collection-sandbox-subscription-key"
# collection_api_user = "your-collection-sandbox-api-user-id"
# collection_api_key = "your-collection-sandbox-api-key"
# disbursement_subscription_key = "your-disbursement-sandbox-subscription-key"
# disbursement_api_user = "your-disbursement-sandbox-api-user-id"
# disbursement_api_key = "your-disbursement-sandbox-api-key"
