# Copy this file to secrets.toml for local development.
# Never commit secrets.toml or share this value.
admin_passcode = "replace-with-a-long-random-passcode"

# Optional production authentication. When client_id is configured,
# CampusFlow requires Streamlit OIDC sign-in before showing the app.
# [auth]
# redirect_uri = "https://your-app.example.com/oauth2callback"
# cookie_secret = "replace-with-a-long-random-cookie-secret"
# client_id = "your-oidc-client-id"
# client_secret = "your-oidc-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
